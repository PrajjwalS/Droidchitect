<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_main"
    android:padding="@dimen/screen_padding">

    <!-- ================= TOP BAR ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Droidchitect"
            android:textColor="@color/accent_orange"
            android:textSize="25sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/status_chip"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:clickable="false"
            android:focusable="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Disconnected"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="@color/bg_secondary"
            app:cornerRadius="18dp" />

    </LinearLayout>

    <!-- ================= PAGE CONTAINER ================= -->
    <FrameLayout
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- ================= BOTTOM NAV BAR ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_margin="10dp"
        android:background="@color/bg_secondary"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="6dp"
        android:weightSum="3">

        <!-- AMP -->
        <TextView
            android:id="@+id/tab_amp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/nav_selected_bg"
            android:gravity="center"
            android:text="AMP"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:background="@color/bg_tertiary" />

        <!-- EFFECTS -->
        <TextView
            android:id="@+id/tab_effects"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:text="EFFECTS"
            android:textColor="@color/text_secondary"
            android:textStyle="normal" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:background="@color/bg_tertiary" />

        <!-- PATCH -->
        <TextView
            android:id="@+id/tab_live"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:text="PATCH"
            android:textColor="@color/text_secondary"
            android:textStyle="normal" />

    </LinearLayout>

</LinearLayout>