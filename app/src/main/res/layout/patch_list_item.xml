<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginBottom="8dp"

    android:orientation="vertical"

    android:background="@drawable/patch_card_bg"

    android:elevation="2dp"

    android:padding="16dp">

    <!-- ================================================== -->
    <!-- PATCH NAME -->
    <!-- ================================================== -->

    <TextView
        android:id="@+id/patchItemName"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:text="Patch Name"

        android:textSize="17sp"

        android:textStyle="bold"

        android:textColor="@color/text_primary"

        android:maxLines="2"

        android:ellipsize="end" />

    <!-- ================================================== -->
    <!-- BUTTON ROW -->
    <!-- ================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginTop="10dp"

        android:orientation="horizontal">

        <!-- LOAD     -->

        <Button
            android:id="@+id/patchItemLoadButton"
            style="@style/ChipButton"
            android:backgroundTint="@color/fg_tertiary"
            android:layout_height="38dp"
            android:text="Load Patch" />


        <!-- DELETE -->

        <Button
            android:id="@+id/patchItemDeleteButton"
            style="@style/ChipButton"
            android:backgroundTint="@color/fg_tertiary"
            android:layout_height="38dp"
            android:text="Delete Patch" />

    </LinearLayout>

</LinearLayout>