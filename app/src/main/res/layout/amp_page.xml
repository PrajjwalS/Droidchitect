<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_main"
    android:padding="@dimen/screen_padding">

    <!-- ================= VOICE GRID ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

        <!-- ROW 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/voice_clean_warm"
                style="@style/ChipButton"
                android:text="Clean Warm" />

            <Button
                android:id="@+id/voice_clean_bright"
                style="@style/ChipButton"
                android:text="Clean Bright" />

            <Button
                android:id="@+id/voice_crunch"
                style="@style/ChipButton"
                android:text="Crunch" />

        </LinearLayout>

        <!-- ROW 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/voice_super_crunch"
                style="@style/ChipButton"
                android:text="Super Crunch" />

            <Button
                android:id="@+id/voice_od1"
                style="@style/ChipButton"
                android:text="OD1" />

            <Button
                android:id="@+id/voice_od2"
                style="@style/ChipButton"
                android:text="OD2" />

        </LinearLayout>

    </LinearLayout>

    <!-- ================= KNOBS ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- ROW 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <com.rejowan.rotaryknob.RotaryKnob
                android:id="@+id/knob_bass"
                style="@style/AmpKnob"
                app:label_text="BASS" />

            <com.rejowan.rotaryknob.RotaryKnob
                android:id="@+id/knob_middle"
                style="@style/AmpKnob"
                app:label_text="MIDDLE" />

            <com.rejowan.rotaryknob.RotaryKnob
                android:id="@+id/knob_treble"
                style="@style/AmpKnob"
                app:label_text="TREBLE" />

        </LinearLayout>

        <!-- ROW 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <com.rejowan.rotaryknob.RotaryKnob
                android:id="@+id/knob_isf"
                style="@style/AmpKnob"
                app:label_text="ISF" />

            <com.rejowan.rotaryknob.RotaryKnob
                android:id="@+id/knob_presence"
                style="@style/AmpKnob"
                app:label_text="PRESENCE" />

            <com.rejowan.rotaryknob.RotaryKnob
                android:id="@+id/knob_resonance"
                style="@style/AmpKnob"
                app:label_text="RESONANCE" />

        </LinearLayout>

        <!-- ROW 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <com.rejowan.rotaryknob.RotaryKnob
                android:id="@+id/knob_gain"
                style="@style/AmpKnob"
                app:label_text="GAIN" />

            <com.rejowan.rotaryknob.RotaryKnob
                android:id="@+id/knob_volume"
                style="@style/AmpKnob"
                app:label_text="VOLUME" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>