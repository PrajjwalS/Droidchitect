<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ===================================================== -->
    <!-- BASE APP THEME -->
    <!-- ===================================================== -->

    <style name="Base.Theme.Droidchitect"
        parent="Theme.Material3.DayNight.NoActionBar">

        <!-- ================================================= -->
        <!-- PRIMARY COLORS -->
        <!-- ================================================= -->

        <item name="colorPrimary">
            @color/accent_orange
        </item>

        <item name="colorSecondary">
            @color/accent_orange
        </item>

        <item name="colorTertiary">
            @color/accent_orange
        </item>

        <!-- ================================================= -->
        <!-- SURFACE / BACKGROUNDS -->
        <!-- ================================================= -->

        <item name="colorSurface">
            @color/bg_secondary
        </item>

        <item name="android:colorBackground">
            @color/bg_primary
        </item>

        <!-- ================================================= -->
        <!-- CONTROL COLORS -->
        <!-- ================================================= -->

        <item name="colorControlActivated">
            @color/accent_orange
        </item>

        <item name="colorControlHighlight">
            @color/bg_tertiary
        </item>

        <item name="android:colorControlHighlight">
            @color/bg_tertiary
        </item>

        <!-- ================================================= -->
        <!-- TEXT SELECTION -->
        <!-- ================================================= -->

        <item name="android:textColorHighlight">
            @android:color/transparent
        </item>

        <!-- ================================================= -->
        <!-- DIALOG THEME -->
        <!-- ================================================= -->

        <item name="materialAlertDialogTheme">
            @style/ThemeOverlay_Droidchitect_Dialog
        </item>

    </style>

    <!-- ===================================================== -->
    <!-- MAIN APP THEME -->
    <!-- ===================================================== -->

    <style name="Theme.Droidchitect"
        parent="Base.Theme.Droidchitect" />

    <!-- ===================================================== -->
    <!-- DIALOG OVERLAY -->
    <!-- ===================================================== -->

    <style name="ThemeOverlay_Droidchitect_Dialog"
        parent="ThemeOverlay.Material3.MaterialAlertDialog">

        <!-- Dialog Background -->

        <item name="colorSurface">
            @color/bg_secondary
        </item>

        <!-- Title/Text -->

        <item name="android:textColorPrimary">
            @color/text_primary
        </item>

        <item name="android:textColorSecondary">
            @color/text_secondary
        </item>

        <!-- Button Styles -->

        <item name="buttonBarPositiveButtonStyle">
            @style/DroidDialogButton
        </item>

        <item name="buttonBarNegativeButtonStyle">
            @style/DroidDialogButton
        </item>

    </style>

    <!-- ===================================================== -->
    <!-- DIALOG BUTTON -->
    <!-- ===================================================== -->

    <style name="DroidDialogButton"
        parent="Widget.Material3.Button.TextButton.Dialog">

        <item name="android:textColor">
            @color/accent_orange
        </item>

        <item name="rippleColor">
            @color/bg_tertiary
        </item>

    </style>

    <!-- ===================================================== -->
    <!-- VOICE BUTTON -->
    <!-- ===================================================== -->

    <style name="VoiceButton">

        <item name="android:layout_width">
            0dp
        </item>

        <item name="android:layout_height">
            @dimen/voice_button_height
        </item>

        <item name="android:layout_weight">
            1
        </item>

        <item name="android:textColor">
            @color/text_primary
        </item>

        <item name="android:textSize">
            12sp
        </item>

        <item name="android:layout_margin">
            @dimen/voice_button_margin
        </item>

        <!-- BUTTON LOOK -->

        <item name="android:backgroundTint">
            @color/bg_tertiary
        </item>

        <item name="cornerRadius">
            18dp
        </item>

        <item name="elevation">
            4dp
        </item>

        <!-- TEXT -->

        <item name="android:gravity">
            center
        </item>

        <item name="android:lines">
            2
        </item>

        <item name="android:ellipsize">
            end
        </item>

        <item name="android:textAlignment">
            center
        </item>

        <item name="android:includeFontPadding">
            false
        </item>

    </style>

    <!-- ===================================================== -->
    <!-- AMP KNOB -->
    <!-- ===================================================== -->

    <style name="AmpKnob">

        <item name="android:layout_width">
            wrap_content
        </item>

        <item name="android:layout_height">
            wrap_content
        </item>

        <item name="android:layout_weight">
            1
        </item>

        <item name="android:layout_margin">
            @dimen/knob_margin
        </item>

        <item name="android:padding">
            @dimen/knob_padding
        </item>

        <item name="label_margin">
            @dimen/knob_label_margin
        </item>

        <item name="max">
            100
        </item>

        <item name="min">
            0
        </item>

        <item name="show_label">
            true
        </item>

        <item name="show_progress_text">
            true
        </item>

        <item name="circle_style">
            gradient
        </item>

        <item name="circle_gradient_outer_color">
            @color/bg_primary
        </item>

        <item name="circle_gradient_center_color">
            @color/bg_tertiary
        </item>

        <item name="border_color">
            @color/bg_tertiary
        </item>

        <item name="progress_style">
            circle
        </item>

        <item name="progress_color">
            @color/bg_tertiary
        </item>

        <item name="progress_filled_color">
            @color/accent_orange
        </item>

        <item name="show_big_progress">
            false
        </item>

        <item name="progress_text_size">
            16dp
        </item>

        <item name="current_progress">
            0
        </item>

        <item name="indicator_style">
            line
        </item>

        <item name="indicator_color">
            @color/accent_orange
        </item>

    </style>

</resources>